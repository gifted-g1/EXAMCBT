# Exam Shield configuration. Copy to .env and edit.
# Real environment variables always override this file.

# --- Mode ----------------------------------------------------------------------
# standalone : one binary, SQLite + in-process Redis + disk blobs + in-process AI
# distributed: MySQL + Redis + MinIO + separate ai-worker (docker-compose.yml)
MODE=standalone
APP_ENV=development          # "production" enables strict secret checks
HTTP_ADDR=:8080              # bind to the LAN IP in production, e.g. 192.168.1.45:443
LOG_LEVEL=info

# --- Network lock (the heart of Exam Shield) ----------------------------------------
LAN_IP=192.168.1.45                     # used by docker-compose / nginx
LAN_CIDRS=192.168.1.0/24                # who may reach the server at all (blank = auto-detect)
LAN_DENY_CIDRS=                         # e.g. VPN address pools inside the LAN range
LAN_ADVERTISE_IP=                       # IP shown on the access card (blank = auto)
PUBLIC_PORT=                            # port shown on the access card (blank = from HTTP_ADDR)
PUBLIC_SCHEME=                          # "https" when a TLS proxy fronts the server
TRUSTED_PROXIES=                        # IPs/CIDRs whose X-Real-IP is believed (blank = none)
ALLOW_LOOPBACK_STAFF=true               # staff may use http://localhost on the server itself
ALLOW_LOOPBACK_EXAM=false               # never true in production
LAN_CIDRS_NGINX=allow 192.168.1.0/24;   # nginx allow-list (compose only)

# --- TLS (browsers only allow webcams on HTTPS) --------------------------------------
TLS_CERT_FILE=                          # e.g. deploy/certs/server.crt (standalone)
TLS_KEY_FILE=                           # e.g. deploy/certs/server.key
HTTP_REDIRECT_ADDR=                     # e.g. :80 → redirects to HTTPS
COOKIE_SECURE=                          # defaults to true when TLS is on

# --- Auth ------------------------------------------------------------------
JWT_SECRET=                             # REQUIRED in production: openssl rand -hex 32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12

# --- Database -----------------------------------------------------------------
SQLITE_PATH=data/examshield.db          # standalone
DB_DSN=                                 # distributed: user:pass@tcp(host:3306)/exam_shield?parseTime=true&loc=UTC
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_AUTO_MIGRATE=false                   # run embedded migrations at API start (MySQL)
SEED_ON_START=false                     # load mock staff/students + demo exam at start
MYSQL_ROOT_PASSWORD=                    # compose only
MYSQL_PASSWORD=                         # compose only

# --- Redis --------------------------------------------------------------------
REDIS_ADDR=                             # blank = embedded in-process Redis (standalone)
REDIS_PASSWORD=
REDIS_DB=0

# --- Object storage --------------------------------------------------------------
BLOB_DIR=data/blobs                     # standalone
MINIO_ENDPOINT=                         # distributed, e.g. minio:9000
MINIO_ROOT_USER=                        # compose: also used as access key
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=exam-shield
MINIO_USE_SSL=false

# --- Exam behaviour -------------------------------------------------------------------
SESSION_LOCK_TTL=2m
SUBMIT_GRACE=2m                         # answers saved offline are still accepted this long after the end
FRAME_MIN_INTERVAL=2s
FACE_MATCH_THRESHOLD=0.75
FACE_MATCH_ENFORCE=auto                 # auto: block only with ArcFace | always | never

# --- AI ------------------------------------------------------------------------
AI_BACKEND=auto                         # auto | onnx | go
AI_WORKERS=4
AI_IN_PROCESS=                          # default: true in standalone, false otherwise
AI_MARKING=false                        # true + ANTHROPIC_API_KEY: examiners may request AI-suggested theory marks (answer text is sent to Anthropic)
ANTHROPIC_API_KEY=
AI_MARKING_MODEL=claude-opus-5-5
AI_WORKER_REPLICAS=1                    # compose
MODEL_DIR=models
ONNXRUNTIME_LIB=
ONNX_USE_CUDA=false

# --- Compliance ----------------------------------------------------------------
RETENTION_DAYS=30                       # media + AI findings purged this long after an exam closes
CONSENT_VERSION=2026-10
